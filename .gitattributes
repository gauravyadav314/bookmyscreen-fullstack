# GitHub Linguist Overrides
# Ensure GitHub correctly detects TypeScript and JavaScript

*.js linguist-language=JavaScript
*.jsx linguist-language=JavaScript
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript

# Ignore generated lock files and static media from language statistics
package-lock.json linguist-generated=true
**/package-lock.json linguist-generated=true
*.avif linguist-vendored
*.png linguist-vendored
*.jpg linguist-vendored
*.gif linguist-vendored
